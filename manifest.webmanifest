{
  "id": "/",
  "name": "AutoPort",
  "short_name": "AutoPort",
  "description": "Convert Tasker and Automate automations into MacroDroid macros. Everything to everything.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1419",
  "theme_color": "#0f1419",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "share",
          "accept": [
            "application/xml",
            "text/xml",
            "application/vnd.com.llamalab.automate.flow",
            "application/octet-stream",
            "application/pdf",
            "image/png"
          ]
        }
      ]
    }
  }
}
